# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_PORT=3000
JWT_SECRET="replace-this-with-a-long-random-secret"
CORS_ORIGIN="http://localhost:4200"

# Demo admin created by prisma/seed.mjs
ADMIN_EMAIL=admin@pawsstore.local
ADMIN_PASSWORD=admin12345

# ---------------------------------------------------------------------------
# PostgreSQL (local development)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pawsstore?schema=public"

# PostgreSQL container (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pawsstore

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
